{
  "_comment": "ai-local-env-checker 配置文件 - 复制为 config.json 使用",
  "version": "0.1.0-beta",
  "settings": {
    "defaultMode": "CheckOnly",
    "enableVerboseLog": false,
    "skipComponents": {
      "codex": false,
      "claude": false,
      "vscode": false,
      "wsl": false
    },
    "network": {
      "timeoutSeconds": 10,
      "retryCount": 2
    },
    "paths": {
      "logDir": "./logs",
      "reportDir": "./reports",
      "backupDir": "./logs"
    },
    "installation": {
      "preferWinget": true,
      "nodeVersion": "LTS",
      "npmGlobalPackages": [
        "@anthropic-ai/claude-code",
        "@openai/codex"
      ]
    },
    "pathCheck": {
      "npmGlobalPath": "%APPDATA%\\npm",
      "vscodeBinPath": "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin",
      "gitCmdPath": "C:\\Program Files\\Git\\cmd"
    }
  }
}
