{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-local-env-checker.local/schema/report.schema.json",
  "title": "AI Local Environment Checker Report",
  "description": "Compatible schema for current script-generated reports and the future product report model.",
  "oneOf": [
    {
      "$ref": "#/$defs/CurrentInstallReport"
    },
    {
      "$ref": "#/$defs/CurrentVerifyReport"
    },
    {
      "$ref": "#/$defs/FutureProductReport"
    },
    {
      "$ref": "#/$defs/PlanRunnerReport"
    }
  ],
  "$defs": {
    "StatusString": {
      "type": "string"
    },
    "FlexibleObject": {
      "type": "object",
      "additionalProperties": true
    },
    "FlexibleArray": {
      "type": "array",
      "items": true
    },
    "CurrentMeta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Version": {
          "type": "string"
        },
        "Timestamp": {
          "type": "string"
        },
        "ComputerName": {
          "type": "string"
        },
        "UserName": {
          "type": "string"
        },
        "IsAdmin": {
          "type": "boolean"
        },
        "Mode": {
          "type": "string"
        },
        "Language": {
          "type": "string"
        },
        "FixPath": {
          "type": "boolean"
        },
        "CommandTimeoutSec": {
          "type": "integer"
        },
        "TimeoutSec": {
          "type": "integer"
        },
        "LogFile": {
          "type": "string"
        }
      }
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "Command": {
          "type": "string"
        },
        "FileName": {
          "type": "string"
        },
        "Arguments": {
          "type": "string"
        },
        "Status": {
          "$ref": "#/$defs/StatusString"
        },
        "ExitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "StdOut": {
          "type": [
            "string",
            "null"
          ]
        },
        "StdErr": {
          "type": [
            "string",
            "null"
          ]
        },
        "ElapsedMs": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        },
        "TimedOut": {
          "type": "boolean"
        }
      }
    },
    "CurrentInstallReport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Meta"
      ],
      "anyOf": [
        {
          "required": [
            "Results"
          ]
        },
        {
          "required": [
            "CommandResults"
          ]
        }
      ],
      "properties": {
        "Meta": {
          "$ref": "#/$defs/CurrentMeta"
        },
        "Results": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "CommandResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandResult"
          }
        },
        "InstallResults": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Summary": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Proxy": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "System": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Node": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Git": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "WSL": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "ClaudeCode": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "CodexCLI": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "VSCode": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "PackageManager": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Errors": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Warnings": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "FixSuggestions": {
          "$ref": "#/$defs/FlexibleArray"
        }
      }
    },
    "CurrentVerifyReport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Meta"
      ],
      "anyOf": [
        {
          "required": [
            "Status"
          ]
        },
        {
          "required": [
            "Commands"
          ]
        }
      ],
      "properties": {
        "Meta": {
          "$ref": "#/$defs/CurrentMeta"
        },
        "Status": {
          "$ref": "#/$defs/StatusString"
        },
        "Commands": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Checks": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Locations": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "CommandDetails": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Summary": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Errors": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Warnings": {
          "$ref": "#/$defs/FlexibleArray"
        }
      }
    },
    "FutureProductReport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "meta",
        "summary"
      ],
      "properties": {
        "meta": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "platform",
            "timestamp",
            "checkOnly"
          ],
          "properties": {
            "platform": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "checkOnly": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "logFile": {
              "type": "string"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "details": {
                "type": [
                  "string",
                  "object",
                  "array",
                  "null"
                ]
              }
            }
          }
        },
        "installPlan": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "execution": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "summary": {
          "$ref": "#/$defs/FlexibleObject"
        }
      }
    },
    "PlanRunnerReport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "Meta",
        "Plan",
        "PolicyDecision",
        "Commands",
        "Results",
        "Verification",
        "Summary"
      ],
      "properties": {
        "Meta": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "version",
            "timestamp",
            "mode",
            "checkOnly"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "checkOnly": {
              "type": "boolean"
            }
          }
        },
        "Plan": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "PolicyDecision": {
          "$ref": "#/$defs/FlexibleObject"
        },
        "Commands": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Results": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Verification": {
          "$ref": "#/$defs/FlexibleArray"
        },
        "Summary": {
          "$ref": "#/$defs/FlexibleObject"
        }
      }
    }
  }
}
