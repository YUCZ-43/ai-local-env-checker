{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-local-env-checker.local/schema/install-plan.schema.json",
  "title": "AI Local Environment Checker Install Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "platform",
    "action",
    "description",
    "commands",
    "requiresAdmin",
    "riskLevel",
    "confirmationRequired",
    "rollbackAvailable",
    "verificationCommands"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["windows", "wsl", "linux", "macos", "darwin", "cross-platform"]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiresAdmin": {
      "type": "boolean"
    },
    "riskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "DANGEROUS"]
    },
    "confirmationRequired": {
      "type": "boolean",
      "const": true
    },
    "rollbackAvailable": {
      "type": "boolean"
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autoExecute": {
      "type": "boolean",
      "const": false,
      "default": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
