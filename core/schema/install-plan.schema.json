{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-local-env-checker.local/schema/install-plan.schema.json",
  "title": "AI Local Environment Checker Install Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "platform",
    "action",
    "description",
    "commands",
    "requiresAdmin",
    "riskLevel",
    "confirmationRequired",
    "rollbackAvailable",
    "verificationCommands"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "toolId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["windows", "wsl", "linux", "macos", "darwin", "cross-platform"]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/Command"
          }
        ]
      }
    },
    "requiresAdmin": {
      "type": "boolean"
    },
    "riskLevel": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confirmationRequired": {
      "type": "boolean",
      "const": true
    },
    "rollbackAvailable": {
      "type": "boolean"
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autoExecute": {
      "type": "boolean",
      "const": false,
      "default": false
    },
    "dryRunOnly": {
      "type": "boolean",
      "default": false
    },
    "expectedResult": {
      "type": "string",
      "minLength": 1
    },
    "rollbackNote": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "RiskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "ADMIN_REQUIRED", "DANGEROUS"]
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "shell",
        "command",
        "requiresAdmin",
        "riskLevel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "enum": ["powershell", "cmd", "bash", "pwsh", "native"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "workingDirectory": {
          "type": "string",
          "default": "."
        },
        "requiresAdmin": {
          "type": "boolean"
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "dryRunOnly": {
          "type": "boolean",
          "default": false
        },
        "confirmationRequired": {
          "type": "boolean",
          "default": true
        },
        "expectedResult": {
          "type": "string",
          "minLength": 1
        },
        "rollbackNote": {
          "type": "string",
          "minLength": 1
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
