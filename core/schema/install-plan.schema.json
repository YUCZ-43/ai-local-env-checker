{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-local-env-checker.local/schema/install-plan.schema.json",
  "title": "AI Local Environment Checker Install Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "platform",
    "action",
    "description",
    "commands",
    "requiresAdmin",
    "riskLevel",
    "confirmationRequired",
    "rollbackAvailable",
    "verificationCommands"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "toolId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["windows", "wsl", "linux", "macos", "darwin", "cross-platform"]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/Command"
          }
        ]
      }
    },
    "requiresAdmin": {
      "type": "boolean"
    },
    "riskLevel": {
      "$ref": "#/$defs/RiskLevel"
    },
    "confirmationRequired": {
      "type": "boolean",
      "const": true
    },
    "rollbackAvailable": {
      "type": "boolean"
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autoExecute": {
      "type": "boolean",
      "const": false,
      "default": false
    },
    "dryRunOnly": {
      "type": "boolean",
      "default": false
    },
    "expectedResult": {
      "type": "string",
      "minLength": 1
    },
    "rollbackNote": {
      "type": "string",
      "minLength": 1
    },
    "adminReason": {
      "type": "string",
      "minLength": 1
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "approvalState": {
      "$ref": "#/$defs/ApprovalState"
    },
    "approvalSummary": {
      "type": "string",
      "minLength": 1
    },
    "rollbackPlan": {
      "type": "string",
      "minLength": 1
    },
    "rollbackWarning": {
      "type": "string",
      "minLength": 1
    },
    "realRunDisabled": {
      "type": "boolean",
      "const": true,
      "default": true
    },
    "dryRunDefault": {
      "type": "boolean",
      "default": true
    },
    "permissionReview": {
      "type": "string",
      "minLength": 1
    },
    "userConfirmed": {
      "type": "boolean",
      "default": false
    },
    "blockedReason": {
      "type": "string",
      "minLength": 1
    },
    "uiSeverity": {
      "$ref": "#/$defs/UiSeverity"
    },
    "displayLanguage": {
      "type": "string",
      "enum": ["en-US", "zh-CN", "zh-TW"]
    },
    "themePreference": {
      "type": "string",
      "enum": ["light", "dark", "system"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "RiskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "ADMIN_REQUIRED", "DANGEROUS"]
    },
    "ApprovalState": {
      "type": "string",
      "enum": ["allowed", "preview-only", "blocked"]
    },
    "UiSeverity": {
      "type": "string",
      "enum": ["success", "warning", "high", "danger", "neutral"]
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "shell",
        "command",
        "requiresAdmin",
        "riskLevel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "enum": ["powershell", "cmd", "bash", "pwsh", "native"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "workingDirectory": {
          "type": "string",
          "default": "."
        },
        "requiresAdmin": {
          "type": "boolean"
        },
        "riskLevel": {
          "$ref": "#/$defs/RiskLevel"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "dryRunOnly": {
          "type": "boolean",
          "default": false
        },
        "confirmationRequired": {
          "type": "boolean",
          "default": true
        },
        "expectedResult": {
          "type": "string",
          "minLength": 1
        },
        "rollbackNote": {
          "type": "string",
          "minLength": 1
        },
        "approvalRequired": {
          "type": "boolean"
        },
        "approvalState": {
          "$ref": "#/$defs/ApprovalState"
        },
        "blockedReason": {
          "type": "string",
          "minLength": 1
        },
        "uiSeverity": {
          "$ref": "#/$defs/UiSeverity"
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
