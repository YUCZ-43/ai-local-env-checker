{
  "id": "windows-rust-go-tauri-plan",
  "platform": "windows",
  "action": "install-rust-go-tauri-template",
  "description": "Dry-run-only future plan for Rust, Go, and Tauri development dependencies on Windows.",
  "commands": [
    {
      "id": "install-go",
      "description": "Future command placeholder for installing Go.",
      "shell": "powershell",
      "command": "winget",
      "args": ["install", "GoLang.Go"],
      "workingDirectory": ".",
      "requiresAdmin": true,
      "riskLevel": "HIGH",
      "timeoutSec": 600,
      "dryRunOnly": true,
      "confirmationRequired": true,
      "verificationCommands": ["go version"]
    },
    {
      "id": "install-rustup",
      "description": "Future command placeholder for Rust toolchain setup. Do not run rustup automatically.",
      "shell": "powershell",
      "command": "Write-Output",
      "args": ["Review rustup installer source and profile before manual execution."],
      "workingDirectory": ".",
      "requiresAdmin": false,
      "riskLevel": "MEDIUM",
      "timeoutSec": 60,
      "dryRunOnly": true,
      "confirmationRequired": true,
      "verificationCommands": ["cargo --version"]
    },
    {
      "id": "verify-tauri-prereqs",
      "description": "Preview Tauri prerequisites after manual installation.",
      "shell": "powershell",
      "command": "cargo",
      "args": ["--version"],
      "workingDirectory": ".",
      "requiresAdmin": false,
      "riskLevel": "LOW",
      "timeoutSec": 30,
      "dryRunOnly": true,
      "confirmationRequired": true,
      "verificationCommands": ["cargo --version", "npm --version"]
    }
  ],
  "requiresAdmin": true,
  "riskLevel": "HIGH",
  "confirmationRequired": true,
  "rollbackAvailable": false,
  "verificationCommands": ["go version", "cargo --version", "npm --version"],
  "autoExecute": false,
  "dryRunOnly": true,
  "notes": ["No rustup installer, package installer, or Tauri packaging command is executed in v0.6.1."]
}
